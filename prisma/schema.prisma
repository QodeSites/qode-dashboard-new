  account_name        String    @db.VarChar(255)
  strategy            String    @db.VarChar(50)
  effective_from      DateTime  @db.Date
  effective_to        DateTime? @db.Date
  profit_tag_suffix   String    @db.VarChar(100)
  exposure_tag_suffix String    @db.VarChar(100)
  equity_pct          Decimal?  @db.Decimal(5, 4)
  debt_pct            Decimal?  @db.Decimal(5, 4)
  lc_pct              Decimal?  @db.Decimal(5, 4)
  cash_pct            Decimal?  @db.Decimal(5, 4)
  gold_pct            Decimal?  @db.Decimal(5, 4)
  momentum_pct        Decimal?  @db.Decimal(5, 4)
  lowvol_pct          Decimal?  @db.Decimal(5, 4)
  derivative_pct      Decimal?  @db.Decimal(5, 4)
  psar_leverage       Decimal?  @db.Decimal(5, 2)
  psar_multiplier     Decimal?  @db.Decimal(5, 2)
  drawdown_margin_pct Decimal?  @db.Decimal(5, 4)
  long_opt_pct        Decimal?  @db.Decimal(5, 4)
  updated_by          String?   @db.VarChar(100)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)
  accounts            accounts  @relation(fields: [qcode], references: [qcode])

  @@unique([qcode, strategy, effective_from])
  @@index([qcode])
  @@index([effective_to])
  @@schema("public")
}

model strategy_defaults {
  strategy_name       String   @id @db.VarChar(50)
  equity_pct          Decimal  @db.Decimal(5, 4)
  debt_pct            Decimal  @db.Decimal(5, 4)
  lc_pct              Decimal  @db.Decimal(5, 4)
  cash_pct            Decimal  @db.Decimal(5, 4)
  gold_pct            Decimal? @db.Decimal(5, 4)
  momentum_pct        Decimal? @db.Decimal(5, 4)
  lowvol_pct          Decimal? @db.Decimal(5, 4)
  derivative_pct      Decimal  @db.Decimal(5, 4)
  psar_leverage       Decimal  @db.Decimal(5, 2)
  psar_multiplier     Decimal  @db.Decimal(5, 2)
  drawdown_margin_pct Decimal  @db.Decimal(5, 4)
  long_opt_pct        Decimal  @db.Decimal(5, 4)
  updated_by          String?  @db.VarChar(100)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)

  @@schema("public")
}

model global_config {
  key        String   @id @db.VarChar(100)
  value      String   @db.VarChar(500)
  data_type  String   @default("string") @db.VarChar(20)
  updated_by String?  @db.VarChar(100)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@schema("public")
}

model sync_jobs {
  id            Int       @id @default(autoincrement())
  job_type      String    @db.VarChar(20)
  status        String    @db.VarChar(20)
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  finished_at   DateTime? @db.Timestamptz(6)
  triggered_by  String    @db.VarChar(50)
  report_date   String?   @db.VarChar(10)
  client_filter String?   @db.VarChar(200)
  error_message String?
  result_json   Json?
  log_output    String?

  @@index([started_at(sort: Desc)])
  @@index([status])
  @@schema("public")
}
